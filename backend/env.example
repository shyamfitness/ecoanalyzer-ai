# Database
# For local development:
# MONGODB_URI=mongodb://localhost:27017/ecoanalyzer
# For production (MongoDB Atlas):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ecoanalyzer
MONGODB_URI=mongodb://localhost:27017/ecoanalyzer
MONGODB_DB_NAME=ecoanalyzer

# OpenAI API (Required)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Authentication (Required)
# Generate a secure random string for production
# Example: openssl rand -base64 32
JWT_SECRET=your_secure_jwt_secret_here

# Barcode lookup (Optional - falls back to OpenFoodFacts if not provided)
BARCODE_LOOKUP_URL=https://api.barcodelookup.com/v3/products
BARCODE_LOOKUP_KEY=your_barcode_lookup_api_key

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration
# For local development:
# FRONTEND_URL=http://localhost:5173,http://localhost:4173
# For production, add your frontend URL:
# FRONTEND_URL=https://your-frontend.vercel.app,https://your-frontend.netlify.app
FRONTEND_URL=http://localhost:5173,http://localhost:4173
